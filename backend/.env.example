DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/fleetflow_db
SECRET_KEY=change-this-secret-key-in-production
REDIS_URL=redis://localhost:6379/0
# Optional. Leave blank to run route optimization on the free local
# distance/ETA estimator instead of live Google Maps data.
GOOGLE_MAPS_API_KEY=
# Comma-separated allowed frontend origins, e.g.
# https://fleetflow.vercel.app,http://127.0.0.1:5500
# Leave as * (default) for local development / easy demoing.
CORS_ORIGINS=*
